# Aisha Bot - Environment Configuration
# Copy to .env and fill in your values

# Telegram Bot (from @BotFather)
TELEGRAM_BOT_TOKEN=8021476472:AAH...

# Groq API (from console.groq.com/keys) - comma-separated for fallback
GROQ_API_KEY=gsk_...

# Bot Owner Telegram User ID (numeric)
